# Resend transactional email configuration (/services booking form)
# 1. Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# 2. Sender identity:
#    - Initial sandbox testing (only delivers to your Resend account email):
#      "Marky Isulat Portfolio <onboarding@resend.dev>"
#    - Production (after verifying markyisulat.dev in Resend):
#      "Marky Isulat <bookings@markyisulat.dev>"
RESEND_FROM_EMAIL="Marky Isulat Portfolio <onboarding@resend.dev>"

# 3. Optional override for where booking inquiries are delivered (defaults to PROFILE.email)
# RESEND_TO_EMAIL="markyisulat@gmail.com"

# 4. Optional visitor confirmation receipt toggle ("true" | "false").
#    When unset, confirmation emails are automatically enabled once RESEND_FROM_EMAIL
#    uses a verified custom domain (anything other than @resend.dev).
# RESEND_SEND_CONFIRMATION=

# Optional Buy Me a Coffee URL for the Thesis & Capstone consultation tier
# NEXT_PUBLIC_BUYMEACOFFEE_URL=
